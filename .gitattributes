# Normalize line endings so contributors do not produce whole-file diffs.
* text=auto eol=lf

*.sln            text eol=crlf
*.csproj         text eol=crlf
*.props          text eol=crlf
*.pubxml         text eol=crlf
*.bat            text eol=crlf
*.ps1            text eol=crlf

*.png            binary
*.ico            binary
*.gif            binary
*.jpg            binary
*.webp           binary
